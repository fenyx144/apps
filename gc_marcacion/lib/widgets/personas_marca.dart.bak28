import 'package:flutter/material.dart';

import '../utils/theme_colors.dart';

typedef PersonaMarca = ({String nombre, String dni});

/// Bloque con encabezado y la lista de personas de una misma marcación.
/// Lo usan el resumen del registro y la pantalla de reportes.
class PersonasMarcaBloque extends StatelessWidget {
  const PersonasMarcaBloque({
    super.key,
    required this.titulo,
    required this.color,
    required this.personas,
    this.detalle,
    this.icono,
    this.trailing,
  });

  final String titulo;
  final Color color;
  final List<PersonaMarca> personas;
  final String? detalle;
  final IconData? icono;
  final Widget? trailing;

  @override
  Widget build(BuildContext context) {
    final inicial = titulo.trim().isEmpty
        ? '?'
        : titulo.trim().substring(0, 1).toUpperCase();
    return Container(
      width: double.infinity,
      margin: const EdgeInsets.only(top: 12),
      decoration: BoxDecoration(
        color: color.withValues(alpha: 0.05),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: color.withValues(alpha: 0.25)),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          Padding(
            padding: const EdgeInsets.fromLTRB(10, 10, 10, 8),
            child: Row(
              children: [
                CircleAvatar(
                  radius: 16,
                  backgroundColor: color.withValues(alpha: 0.16),
                  child: icono != null
                      ? Icon(icono, color: color, size: 18)
                      : Text(
                          inicial,
                          style: TextStyle(
                            color: color,
                            fontWeight: FontWeight.w800,
                            fontSize: 13,
                          ),
                        ),
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        titulo,
                        maxLines: 1,
                        overflow: TextOverflow.ellipsis,
                        style: TextStyle(
                          color: context.textThemePrimary,
                          fontWeight: FontWeight.w800,
                        ),
                      ),
                      if (detalle != null && detalle!.isNotEmpty)
                        Text(
                          detalle!,
                          maxLines: 1,
                          overflow: TextOverflow.ellipsis,
                          style: TextStyle(
                            color: context.textThemeMuted,
                            fontSize: 12,
                          ),
                        ),
                    ],
                  ),
                ),
                Container(
                  padding:
                      const EdgeInsets.symmetric(horizontal: 8, vertical: 2),
                  decoration: BoxDecoration(
                    color: color.withValues(alpha: 0.14),
                    borderRadius: BorderRadius.circular(10),
                  ),
                  child: Text(
                    '${personas.length}',
                    style: TextStyle(
                      color: color,
                      fontWeight: FontWeight.w800,
                      fontSize: 12.5,
                    ),
                  ),
                ),
                if (trailing != null) ...[
                  const SizedBox(width: 8),
                  trailing!,
                ],
              ],
            ),
          ),
          for (var i = 0; i < personas.length; i++) ...[
            Divider(
              height: 1,
              thickness: 1,
              indent: 10,
              endIndent: 10,
              color: context.borderSubtle.withValues(alpha: 0.6),
            ),
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
              child: Row(
                children: [
                  Expanded(
                    child: Text(
                      personas[i].nombre,
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                      style: TextStyle(
                        color: context.textThemePrimary,
                        fontWeight: FontWeight.w600,
                        fontSize: 14,
                      ),
                    ),
                  ),
                  const SizedBox(width: 8),
                  Text(
                    personas[i].dni,
                    style: TextStyle(
                      color: context.textThemeMuted,
                      fontSize: 12.5,
                      fontFeatures: const [FontFeature.tabularFigures()],
                    ),
                  ),
                ],
              ),
            ),
          ],
          const SizedBox(height: 2),
        ],
      ),
    );
  }
}