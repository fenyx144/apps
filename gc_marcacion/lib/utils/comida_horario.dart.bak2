const String horarioOrigenReferencia = 'referencia_horario_despacho';

HorarioComida? horarioDe({
  required String grupo,
  required String nomGrupo,
  List<HorarioComida> remotos = const [],
  String origen = horarioOrigenReferencia,
}) {
  final key = normGrupo(grupo, nomGrupo);
  final usarRemoto = remotos.isNotEmpty && origen != horarioOrigenReferencia;
  final fuente = usarRemoto ? remotos : horariosReferencia;
  final coinciden = fuente.where((h) => h.grupo == key).toList();
  final lista = coinciden.isNotEmpty
      ? coinciden
      : (usarRemoto
            ? horariosReferencia.where((h) => h.grupo == key).toList()
            : const <HorarioComida>[]);
  if (lista.isEmpty) return null;
  return HorarioComida(
    sede: '',
    grupo: key,
    nomGrupo: lista.first.nomGrupo,
    desayuno: lista.any((h) => h.desayuno),
    almuerzo: lista.any((h) => h.almuerzo),
    cena: lista.any((h) => h.cena),
  );
}

/// Comida más probable según la hora, para abrir el ingreso masivo
/// en el turno que toca: desayuno hasta las 10, almuerzo hasta las 17
/// y cena el resto del día.
Comida comidaSugerida(DateTime ahora) {
  final h = ahora.hour;
  if (h < 10) return Comida.desayuno;
  if (h < 17) return Comida.almuerzo;
  return Comida.cena;
}

enum MarcaPersonaEstado { pendiente, marcada, sinInicio }

/// En el fin hace falta el inicio de esa misma comida. Quien ya tiene
/// la marca queda como [MarcaPersonaEstado.marcada] y se puede volver
/// a elegir para corregir la hora.
MarcaPersonaEstado estadoMarcacion({
  required MomentoComida momento,
  required bool tieneInicio,
  required bool tieneEstaMarca,
}) {
  if (momento == MomentoComida.fin && !tieneInicio) {
    return MarcaPersonaEstado.sinInicio;
  }
  if (tieneEstaMarca) return MarcaPersonaEstado.marcada;
  return MarcaPersonaEstado.pendiente;
}

String notaMarcacion({
  required MarcaPersonaEstado estado,
  required MomentoComida momento,
  String? horaMarca,
  String? horaInicio,
}) {
  switch (estado) {
    case MarcaPersonaEstado.marcada:
      return (horaMarca ?? '').trim();
    case MarcaPersonaEstado.sinInicio:
      return 'Falta inicio';
    case MarcaPersonaEstado.pendiente:
      final ini = (horaInicio ?? '').trim();
      if (momento == MomentoComida.fin && ini.isNotEmpty) {
        return 'Inicio $ini';
      }
      return '';
  }
}

class GrupoMarcacion {
  const GrupoMarcacion({
    required this.clave,
    required this.titulo,
    required this.personas,
    required this.comidas,
    required this.permite,
  });

  final String clave;
  final String titulo;
  final List<PersonalDespacho> personas;
  final List<Comida> comidas;

  /// Falso cuando el grupo come, pero no esta [comida].
  final bool permite;
}

/// Agrupa al personal por código operativo para el ingreso masivo.
///
/// Quien no tiene ninguna comida (descanso, vacaciones, administrativo)
/// no entra. Los grupos que no toman [comida] quedan al final, con
/// [GrupoMarcacion.permite] en falso, para verlos sin poder marcarlos.
List<GrupoMarcacion> agruparMarcacion({
  required List<PersonalDespacho> personas,
  required Comida comida,
  List<HorarioComida> remotos = const [],
  String origen = horarioOrigenReferencia,
}) {
  final orden = <String>[];
  final porClave = <String, List<PersonalDespacho>>{};
  final titulo = <String, String>{};
  final horario = <String, HorarioComida>{};

  for (final p in personas) {
    final h = horarioDe(
      grupo: p.grupo,
      nomGrupo: p.nomGrupo,
      remotos: remotos,
      origen: origen,
    );
    if (h == null || h.comidas.isEmpty) continue;
    final clave = h.grupo.isEmpty ? normGrupo(p.grupo, p.nomGrupo) : h.grupo;
    if (clave.isEmpty) continue;
    porClave
        .putIfAbsent(clave, () {
          orden.add(clave);
          return <PersonalDespacho>[];
        })
        .add(p);
    titulo.putIfAbsent(
      clave,
      () => p.grupoVisible.trim().isEmpty ? clave : p.grupoVisible.trim(),
    );
    horario.putIfAbsent(clave, () => h);
  }

  final permite = {for (final c in orden) c: horario[c]!.permite(comida)};
  final claves = [...orden]..sort((a, b) => _compararGrupo(a, b, permite));
  return [
    for (final c in claves)
      GrupoMarcacion(
        clave: c,
        titulo: titulo[c]!,
        personas: porClave[c]!,
        comidas: horario[c]!.comidas,
        permite: permite[c] ?? false,
      ),
  ];
}

int _numeroGrupo(String clave) {
  final m = RegExp(r'^G(\d+)$').firstMatch(clave);
  if (m == null) return 1000;
  return int.parse(m.group(1)!);
}

int _compararGrupo(String a, String b, Map<String, bool> permite) {
  final pa = permite[a] == true ? 0 : 1;
  final pb = permite[b] == true ? 0 : 1;
  if (pa != pb) return pa - pb;
  final na = _numeroGrupo(a);
  final nb = _numeroGrupo(b);
  if (na != nb) return na.compareTo(nb);
  return a.compareTo(b);
}

/// Granja de 3 dígitos + campaña de 3 dígitos. Ejemplo: 621 y 192 → 621192.
String tcencosDe(String granja, String campania) {
  String tres(String raw) {
    var d = raw.replaceAll(RegExp(r'\D'), '');
    if (d.isEmpty) return '';
    if (d.length > 3) d = d.substring(d.length - 3);
    return d.padLeft(3, '0');
  }

  final g = tres(granja);
  final c = tres(campania);
  if (g.isEmpty || c.isEmpty) return '';
  return '$g$c';
}

String hoyYmd([DateTime? ahora]) {
  final d = ahora ?? DateTime.now();
  final m = d.month.toString().padLeft(2, '0');
  final day = d.day.toString().padLeft(2, '0');
  return '${d.year}-$m-$day';
}
