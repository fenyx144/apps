/// Comidas del personal de despacho y códigos de la tabla `marc`.
///
/// Los tipos 1 a 3 los usa el reloj (entrada, salida y marcas intermedias).
/// Estas seis marcas de comida ocupan 4 a 9.
enum Comida { desayuno, almuerzo, cena }

enum MomentoComida { inicio, fin }

class TipoMarcacion {
  static const int desayunoInicio = 4;
  static const int desayunoFin = 5;
  static const int almuerzoInicio = 6;
  static const int almuerzoFin = 7;
  static const int cenaInicio = 8;
  static const int cenaFin = 9;

  static const Set<int> validos = {
    desayunoInicio,
    desayunoFin,
    almuerzoInicio,
    almuerzoFin,
    cenaInicio,
    cenaFin,
  };

  static int codigo(Comida comida, MomentoComida momento) {
    return switch (comida) {
      Comida.desayuno =>
        momento == MomentoComida.inicio ? desayunoInicio : desayunoFin,
      Comida.almuerzo =>
        momento == MomentoComida.inicio ? almuerzoInicio : almuerzoFin,
      Comida.cena => momento == MomentoComida.inicio ? cenaInicio : cenaFin,
    };
  }

  static Comida? comidaDe(int tipo) {
    return switch (tipo) {
      desayunoInicio || desayunoFin => Comida.desayuno,
      almuerzoInicio || almuerzoFin => Comida.almuerzo,
      cenaInicio || cenaFin => Comida.cena,
      _ => null,
    };
  }

  static MomentoComida? momentoDe(int tipo) {
    return switch (tipo) {
      desayunoInicio || almuerzoInicio || cenaInicio => MomentoComida.inicio,
      desayunoFin || almuerzoFin || cenaFin => MomentoComida.fin,
      _ => null,
    };
  }
}

class PersonalDespacho {
  const PersonalDespacho({
    required this.dni,
    required this.codigo,
    required this.nombre,
    required this.cargo,
    required this.grupo,
    required this.nomGrupo,
    required this.fecha,
    this.horas = '',
    this.estado = '',
  });

  final String dni;
  final String codigo;
  final String nombre;
  final String cargo;
  final String grupo;
  final String nomGrupo;
  final String fecha;
  final String horas;
  final String estado;

  String get grupoVisible {
    final nom = nomGrupo.trim();
    final cod = grupo.trim();
    if (nom.isEmpty) return cod;
    if (cod.isEmpty || nom.toLowerCase().contains(cod.toLowerCase())) {
      return nom;
    }
    return '$cod · $nom';
  }

  factory PersonalDespacho.fromJson(Map<dynamic, dynamic> json) {
    String pick(List<String> keys) {
      for (final k in keys) {
        final v = json[k]?.toString().trim() ?? '';
        if (v.isNotEmpty) return v;
      }
      return '';
    }

    return PersonalDespacho(
      dni: pick(['dni', 'tdni', 'documento']).replaceAll(RegExp(r'\D'), ''),
      codigo: pick(['codigo', 'cod_tra', 'cod_trabajador', 'codtra']),
      nombre: pick(['nombre', 'nom_tra', 'nomtra', 'apellidos_nombres']),
      cargo: pick(['cargo', 'nom_cargo', 'cargo_base']),
      grupo: pick(['grupo', 'cod_grupo']),
      nomGrupo: pick(['nom_grupo', 'nombre_grupo', 'nomGrupo']),
      fecha: pick(['fecha']).length >= 10
          ? pick(['fecha']).substring(0, 10)
          : pick(['fecha']),
      horas: pick(['horas']),
      estado: pick(['estado']),
    );
  }
}

class HorarioComida {
  const HorarioComida({
    required this.sede,
    required this.grupo,
    required this.nomGrupo,
    required this.desayuno,
    required this.almuerzo,
    required this.cena,
  });

  final String sede;
  final String grupo;
  final String nomGrupo;
  final bool desayuno;
  final bool almuerzo;
  final bool cena;

  bool permite(Comida comida) {
    return switch (comida) {
      Comida.desayuno => desayuno,
      Comida.almuerzo => almuerzo,
      Comida.cena => cena,
    };
  }

  List<Comida> get comidas {
    return [
      if (desayuno) Comida.desayuno,
      if (almuerzo) Comida.almuerzo,
      if (cena) Comida.cena,
    ];
  }

  factory HorarioComida.fromJson(Map<dynamic, dynamic> json) {
    bool flag(dynamic v) {
      if (v is bool) return v;
      if (v is num) return v != 0;
      final s = v?.toString().trim().toLowerCase() ?? '';
      return s == '1' || s == 'true' || s == 'si' || s == 'sí';
    }

    return HorarioComida(
      sede: normSede(json['sede']?.toString() ?? ''),
      grupo: normGrupo(
        json['grupo']?.toString() ?? '',
        json['nom_grupo']?.toString() ?? json['nomGrupo']?.toString() ?? '',
      ),
      nomGrupo: (json['nom_grupo'] ?? json['nomGrupo'] ?? '').toString(),
      desayuno: flag(json['desayuno']),
      almuerzo: flag(json['almuerzo']),
      cena: flag(json['cena']),
    );
  }
}

const String sedeJoya = 'joya';
const String sedeMollendo = 'mollendo';

String normSede(String raw) {
  final s = raw.trim().toLowerCase();
  if (s.contains('moll')) return sedeMollendo;
  if (s.contains('joya') || s == 'j') return sedeJoya;
  return s;
}

String etiquetaSede(String sede) {
  return sede == sedeMollendo ? 'Mollendo' : 'Joya';
}

/// Código de grupo operativo G1–G6. El resto (descanso, vacaciones,
/// administrativo) queda con su propio código y no tiene comidas.
String normGrupo(String grupo, String nomGrupo) {
  final texto = '${grupo.trim()} ${nomGrupo.trim()}'.toLowerCase();
  final g = RegExp(r'g\s*0*(\d+)').firstMatch(grupo.trim().toLowerCase());
  if (g != null) {
    final n = int.tryParse(g.group(1)!);
    if (n != null && n >= 1 && n <= 6) return 'G$n';
    if (n != null) return 'G$n';
  }
  final solo = RegExp(r'^0*(\d+)$').firstMatch(grupo.trim());
  if (solo != null) {
    final n = int.tryParse(solo.group(1)!);
    if (n != null && n >= 1 && n <= 6) return 'G$n';
  }
  if (texto.contains('autom')) return 'G1';
  if (texto.contains('despob') || texto.contains('brasa')) return 'G2';
  final carne = RegExp(r'carne\s*0*(\d)').firstMatch(texto);
  if (carne != null) {
    final n = int.tryParse(carne.group(1)!);
    if (n != null && n >= 1 && n <= 4) return 'G${n + 2}';
  }
  return grupo.trim().toUpperCase();
}

String etiquetaComida(Comida comida) {
  return switch (comida) {
    Comida.desayuno => 'Desayuno',
    Comida.almuerzo => 'Almuerzo',
    Comida.cena => 'Cena',
  };
}

String etiquetaMomento(MomentoComida momento) {
  return momento == MomentoComida.inicio ? 'Inicio' : 'Fin';
}

