import '../utils/toast_helper.dart';
import '../widgets/screen_status_bar.dart';
import 'register_device_screen.dart';

class LoginScreen extends StatefulWidget {
  const LoginScreen({super.key});

  @override
  State<LoginScreen> createState() => _LoginScreenState();
}

class _LoginScreenState extends State<LoginScreen> {
  final _formKey = GlobalKey<FormState>();
  final _usuarioController = TextEditingController();
  final _passwordController = TextEditingController();
  final _api = ApiService();
  bool _isLoading = false;
  bool _obscurePassword = true;
  late FocusNode _passwordFocusNode;
  bool _hasAttemptedValidation = false;

  /// ¿Hay red para intentar el login en línea?
  ///
  /// Con un tope corto: en una red lenta o cautiva el `lookup` podía quedarse
  /// esperando y el vigilante veía el cargando sin fin. Ante la duda se dice
  /// «no hay red» y el login sigue por el camino offline.
  Future<bool> _hasInternet() async {
    try {
      // Se prueba contra el propio servidor (no google.com): si el DNS de google
      // falla o tarda en la red del equipo, igual se intenta el login en linea.
      final host = Uri.parse(AppConstants.baseUrl).host;
      final r = await InternetAddress.lookup(host)
          .timeout(const Duration(seconds: 5));
      return r.isNotEmpty && r.first.rawAddress.isNotEmpty;
    } on SocketException {
      return false;
    } on TimeoutException {
      return false;
    } catch (_) {
      return false;
    }
  }

  Future<String> _getDeviceId() async {
    final plugin = DeviceInfoPlugin();
    if (Platform.isAndroid) {
      final a = await plugin.androidInfo;
      return a.id;
    }
    return 'unknown';
  }

  /// ¿Hay algo en el equipo para validar usuario/clave sin servidor?
  ///
  /// Puede ser el hash del último login en línea o el catálogo de usuarios
  /// descargado (password_hex / libtri). Sin ninguno de los dos, en offline no
  /// hay forma de saber si la clave es correcta.
  bool _tieneRespaldoOffline(StorageService storage, CatalogService catalog) {
    if ((storage.getOfflineHash() ?? '').trim().isNotEmpty) return true;
    final usuarios = catalog.catalogos['usuarios'];
    return usuarios is List && usuarios.isNotEmpty;
  }

  static const String _msgSinConexion = 'Sin conexión. Inténtelo más tarde.';
  static const String _msgLoginFallido =
      'No se pudo iniciar sesión. Inténtelo más tarde.';

  String _avisoLoginOffline({required bool sinConexion, required bool sinRespaldo}) {
    if (sinConexion && sinRespaldo) return _msgSinConexion;
    if (sinRespaldo) return _msgLoginFallido;
    return 'Usuario o contraseña incorrectos.';
  }

  /// Mensaje claro cuando el login en línea falla (código del servidor).
  String _mensajeErrorLoginOnline(Map<String, dynamic> result) {
    switch (result['errorCode']?.toString()) {
      case 'USER_NOT_FOUND':
        return 'El usuario no existe. Verifique el código ingresado.';
      case 'WRONG_PASSWORD':
        return 'Contraseña incorrecta.';
      case 'INVALID_TOKEN':
        return 'Error de conexión con el servidor. Inténtelo más tarde.';
      default:
        final msg = result['message']?.toString().trim() ?? '';
        if (msg.isNotEmpty) return msg;
        return _msgLoginFallido;
    }
  }

  Future<void> _attemptOfflineLogin({
    bool mostrarCarga = true,
    bool sinConexion = false,
  }) async {
    void Function()? close;
    if (mostrarCarga) {
      close = showChickenLoadingDialog(context, 'Verificando credenciales...');
    }
    try {
      final catalog = context.read<CatalogService>();
      await catalog.loadFromPrefs();
      final storage = context.read<StorageService>();
      final sinRespaldo = !_tieneRespaldoOffline(storage, catalog);
      final deviceId = await _getDeviceId();
      final userIn = _usuarioController.text.trim().toLowerCase();
      final passIn = _passwordController.text;

      // 1) offline_hash (del último login online del dispositivo)
      final storedHash = storage.getOfflineHash() ?? '';
      final savedUser = storage.getUserCodeSync()?.trim().toLowerCase() ?? '';
      if (storedHash.isNotEmpty) {
        final inputHash = sha256
            .convert(utf8.encode(passIn + AppConstants.offlineSalt))
            .toString();
        final userOk = savedUser.isEmpty || userIn == savedUser;
        if (inputHash == storedHash && userOk) {
          await storage.saveLoginSession(
            userCode: savedUser.isNotEmpty ? savedUser : userIn,
            userName: storage.getUserName() ?? userIn,
            deviceId: deviceId,
          );
          await dismissLoadingDialog(close);
          if (!mounted) return;
          showSuccessToast(context, 'Inicio de sesión exitoso (offline)');
          await AppVersionService.notifyIfNeeded(context, storage);
          if (!mounted) return;
          BioNavigation.irAlDashboardTrasLogin();
          return;
        }
      }

      // 2) AES password_hex + enom
      final usuarios = catalog.catalogos['usuarios'] as List?;
      final conempreList = catalog.catalogos['conempre'] as List?;
      final enomCandidates = <String>[];
      final savedEnom = storage.getLoginEnom() ?? '';
      if (savedEnom.isNotEmpty) enomCandidates.add(savedEnom);
      if (conempreList != null) {
        for (final ce in conempreList) {
          if (ce is! Map) continue;
          final raw = ce['enom']?.toString() ?? '';
          if (raw.isNotEmpty) enomCandidates.add(raw);
        }
      }
      final uniqueEnoms = enomCandidates.toSet().toList();
      if (usuarios != null && uniqueEnoms.isNotEmpty) {
        for (final u in usuarios) {
          if (u is! Map) continue;
          final codigo = u['codigo']?.toString().trim().toLowerCase() ?? '';
          final passHex =
              (u['password_hex']?.toString() ?? '').trim().toUpperCase();
          if (codigo != userIn || passHex.isEmpty) continue;
          for (final enom in uniqueEnoms) {
            if (computePasswordHex(passIn, enom) == passHex) {
              final nombre = u['nombre']?.toString() ?? codigo;
              await storage.saveLoginSession(
                userCode: codigo,
                userName: nombre,
                deviceId: deviceId,
              );
              await dismissLoadingDialog(close);
              if (!mounted) return;
              showSuccessToast(context, 'Inicio de sesión exitoso (offline)');
              await AppVersionService.notifyIfNeeded(context, storage);
              if (!mounted) return;
              BioNavigation.irAlDashboardTrasLogin();
              return;
            }
          }
        }
      }

      // 3) libtri
      if (usuarios != null) {
        for (final u in usuarios) {
          if (u is! Map) continue;
          final codigo = u['codigo']?.toString().trim().toLowerCase() ?? '';
          if (codigo != userIn) continue;
          final libtri = u['libtri']?.toString() ?? '';
          if (libtri.isNotEmpty && passIn == libtri) {
            final nombre = u['nombre']?.toString() ?? codigo;
            await storage.saveLoginSession(
              userCode: codigo,
              userName: nombre,
              deviceId: deviceId,
            );
            await dismissLoadingDialog(close);
            if (!mounted) return;
            showSuccessToast(context, 'Inicio de sesión exitoso (offline)');
            await AppVersionService.notifyIfNeeded(context, storage);
            if (!mounted) return;
            BioNavigation.irAlDashboardTrasLogin();
            return;
          }
        }
      }

      await dismissLoadingDialog(close);
      if (!mounted) return;
      showErrorToast(
        context,
        _avisoLoginOffline(sinConexion: sinConexion, sinRespaldo: sinRespaldo),
      );
    } catch (_) {
      await dismissLoadingDialog(close);
      if (!mounted) return;
      final catalog = context.read<CatalogService>();
      final storage = context.read<StorageService>();
      final sinRespaldo = !_tieneRespaldoOffline(storage, catalog);
      showErrorToast(
        context,
        _avisoLoginOffline(sinConexion: sinConexion, sinRespaldo: sinRespaldo),
      );
    }
  }

  Future<void> _login() async {
    FocusManager.instance.primaryFocus?.unfocus();

    setState(() {
      _hasAttemptedValidation = true;
    });

    var isValid = true;
    if (_usuarioController.text.trim().isEmpty) isValid = false;
    if (_passwordController.text.isEmpty) isValid = false;
    if (!isValid) return;

    setState(() => _isLoading = true);
    final hasNet = await _hasInternet();
    if (!hasNet) {
      setState(() => _isLoading = false);
      await _attemptOfflineLogin(sinConexion: true);
      return;
    }

    final close = showChickenLoadingDialog(context, 'Iniciando sesión...');
    final start = DateTime.now();
    try {
      final deviceId = await _getDeviceId();
      final result = await _api.login(
        usuario: _usuarioController.text.trim(),
        password: _passwordController.text,
        androidId: deviceId,
        version: AppConstants.appVersion,
      );
      if (result['success'] == true) {
        final elapsed = DateTime.now().difference(start);
        if (elapsed.inMilliseconds < 2000) {
          await Future.delayed(
            Duration(milliseconds: 2000 - elapsed.inMilliseconds),
          );
        }
        final data = result['data'];
        String codigo = _usuarioController.text.trim();
        String nombre = codigo;
        if (data is Map && data['usuario'] is List && (data['usuario'] as List).isNotEmpty) {
          final u = (data['usuario'] as List).first as Map;
          codigo = (u['codigo'] ?? codigo).toString();
          nombre = (u['nombre'] ?? codigo).toString();
        }
        await context.read<StorageService>().saveLoginSession(
              userCode: codigo,
              userName: nombre,
              deviceId: deviceId,
            );
        final storage = context.read<StorageService>();
        if (data is Map) {
          final oh = data['offline_hash']?.toString() ?? '';
          if (oh.isNotEmpty) await storage.saveOfflineHash(oh);
          final enom = data['enom']?.toString() ?? '';
          if (enom.isNotEmpty) await storage.saveLoginEnom(enom);
          final verPayload = AppVersionService.extractPayload(data);
          if (verPayload != null) {
            await AppVersionService.mergeServerPayload(storage, verPayload);
          }
        }
        await dismissLoadingDialog(close);
        if (!mounted) return;
        showSuccessToast(context, 'Inicio de sesión exitoso');
        await AppVersionService.notifyIfNeeded(context, storage);
        if (!mounted) return;
        BioNavigation.irAlDashboardTrasLogin();
      } else {
        final code = result['errorCode']?.toString() ?? '';
        if (code == 'APP_VERSION_BLOCKED') {
          await dismissLoadingDialog(close);
          final storage = context.read<StorageService>();
          final verPayload = AppVersionService.extractPayload(result['data']);
          if (verPayload != null) {
            await AppVersionService.mergeServerPayload(storage, verPayload);
          }
          if (mounted) {
            await AppVersionService.showStatusDialog(
              context,
              AppVersionService.fromStorage(storage),
              barrierDismissible: false,
            );
          }
        } else if (code == 'DEVICE_NOT_REGISTERED' || code == 'DEVICE_INACTIVE') {
          await dismissLoadingDialog(close);
          showAppDialog<void>(
            context: context,
            builder: (ctx) => AlertDialog(
              title: Text(
                'Dispositivo no registrado',
                style: TextStyle(color: ctx.textThemePrimary),
              ),
              content: Text(
                result['message']?.toString() ?? '',
                style: TextStyle(color: ctx.textThemeMuted),
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(ctx),
                  child: const Text('Cancelar'),
                ),
                ElevatedButton(
                  onPressed: () {
                    Navigator.pop(ctx);
                    Get.to(() => const RegisterDeviceScreen());
                  },
                  child: const Text('Registrar'),
                ),
              ],
            ),
          );
        } else if (code == 'CONNECTIVITY') {
          await dismissLoadingDialog(close);
          if (!mounted) return;
          await _attemptOfflineLogin(
            sinConexion: true,
            mostrarCarga: false,
          );
        } else {
          await dismissLoadingDialog(close);
          if (!mounted) return;
          showErrorToast(context, _mensajeErrorLoginOnline(result));
        }
      }
    } catch (_) {
      await dismissLoadingDialog(close);
      if (!mounted) return;
      await _attemptOfflineLogin(
        sinConexion: true,
        mostrarCarga: false,
      );
    } finally {
      if (mounted) setState(() => _isLoading = false);
    }
  }

  @override
  void initState() {
    super.initState();
    _passwordFocusNode = FocusNode();
    _usuarioController.addListener(() {
      if (_hasAttemptedValidation && _usuarioController.text.isNotEmpty) {
        setState(() {});
      }
    });
    _passwordController.addListener(() {
      if (_hasAttemptedValidation && _passwordController.text.isNotEmpty) {
        setState(() {});
      }
    });
  }

  @override
  void dispose() {
    _usuarioController.dispose();
    _passwordController.dispose();
    _passwordFocusNode.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return ScreenStatusBar(
      color: AppColors.primary,
      iconBrightness: Brightness.light,
      child: Scaffold(
      backgroundColor: context.scaffoldMuted,
      body: SafeArea(
        top: false,
        bottom: true,
        child: SingleChildScrollView(
          child: Column(
            children: [
              _buildHeader(),
              const SizedBox(height: 40),
              _buildLoginForm(),
              const SizedBox(height: 32),
              Padding(
                padding: const EdgeInsets.symmetric(horizontal: 20),
                child: Text(
                  'v${AppConstants.appVersion}',
                  style: TextStyle(
                    color: context.textThemeMuted,
                    fontSize: 12,
                    fontWeight: FontWeight.w400,
                  ),
                ),
              ),
              const SizedBox(height: 40),
            ],
          ),
        ),
      ),
      ),
    );
  }

  Widget _buildHeader() {
    final topPad = 32 + MediaQuery.viewPaddingOf(context).top;
    return ClipPath(
      clipper: TopWaveClipper(),
      child: Container(
        width: double.infinity,
        constraints: const BoxConstraints(minHeight: 260),
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            colors: [AppColors.primary, AppColors.primaryLight],
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
          ),
        ),
        child: Padding(
          padding: EdgeInsets.fromLTRB(28, topPad, 28, 56),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            mainAxisSize: MainAxisSize.min,
            children: [
              Container(
                width: 84,
                height: 84,
                decoration: BoxDecoration(
                  color: Colors.white.withValues(alpha: 0.2),
                  shape: BoxShape.circle,
                ),
                child: Center(
                  child: Image.asset(
                    'assets/images/logo_grs.png',
                    width: 58,
                    height: 58,
                    color: Colors.white,
                    fit: BoxFit.contain,
                  ),
                ),
              ),
              const SizedBox(height: 16),
              SizedBox(
                width: double.infinity,
                child: Text(
                  AppConstants.appTitle,
                  textAlign: TextAlign.center,
                  softWrap: true,
                  maxLines: 2,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 24,
                    fontWeight: FontWeight.w800,
                    letterSpacing: 0.2,
                    height: 1.2,
                    shadows: [
                      Shadow(
                        blurRadius: 4,
                        color: Colors.black12,
                        offset: Offset(0, 1),
                      ),
                    ],
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildLoginForm() {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 20),
      child: Container(
        decoration: BoxDecoration(
          color: context.surfaceCard,
          borderRadius: BorderRadius.circular(AppColors.radiusXl),
          border: Border.all(
            color: context.borderSubtle.withValues(alpha: 0.9),
          ),
          boxShadow: AppColors.mediumShadow,
        ),
        child: Padding(
          padding: const EdgeInsets.fromLTRB(22, 26, 22, 22),
          child: Form(
            key: _formKey,
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                _buildUserField(),
                const SizedBox(height: 4),
                _buildUserError(),
                const SizedBox(height: 12),
                _buildPasswordField(),
                const SizedBox(height: 4),
                _buildPasswordError(),
                const SizedBox(height: 24),
                _buildLoginButton(),
                const SizedBox(height: 20),
                _buildDivider(),
                const SizedBox(height: 20),
                _buildRegisterDeviceButton(),
              ],
            ),
          ),
        ),
      ),
    );
  }

  OutlineInputBorder _loginFieldBorder(Color color, {double width = 1}) {
    return OutlineInputBorder(
      borderRadius: BorderRadius.circular(12),
      borderSide: BorderSide(color: color, width: width),
      gapPadding: 6,
    );
  }

  Color get _loginFieldBorderColor =>
      context.isAppDark ? context.borderSubtle : const Color(0xFFCBD5E1);

  Color get _loginFieldFillColor =>
      context.isAppDark ? context.surfaceCard : AppColors.background;

  Widget _buildUserField() {
    final isDark = context.isAppDark;
    return Container(
      decoration: BoxDecoration(
        borderRadius: BorderRadius.circular(12),
        boxShadow: isDark ? null : context.cardShadow(blur: 4, dy: 2),
      ),
      child: TextFormField(
        controller: _usuarioController,
        textInputAction: TextInputAction.next,
        textCapitalization: TextCapitalization.characters,
        onEditingComplete: () {
          FocusScope.of(context).requestFocus(_passwordFocusNode);
        },
        style: TextStyle(
          fontSize: 16,
          fontWeight: FontWeight.w500,
          color: context.textThemePrimary,
        ),
        decoration: InputDecoration(
          labelText: 'Usuario',
          floatingLabelBehavior: FloatingLabelBehavior.auto,
          labelStyle: TextStyle(
            color: context.textThemeMuted,
            fontWeight: FontWeight.w500,
            fontSize: 14,
          ),
          floatingLabelStyle: const TextStyle(
            color: AppColors.primary,
            fontWeight: FontWeight.w600,
            fontSize: 13,
          ),
          hintText: 'Ingresa tu usuario',
          hintStyle: TextStyle(color: context.textThemeMuted.withValues(alpha: 0.7)),
          prefixIcon: Padding(
            padding: const EdgeInsets.all(12),
            child: Icon(
              Icons.person_rounded,
              color: context.textThemeMuted,
              size: 22,
            ),
          ),
          filled: true,
          fillColor: _loginFieldFillColor,
          border: _loginFieldBorder(_loginFieldBorderColor),
          enabledBorder: _loginFieldBorder(_loginFieldBorderColor),
          focusedBorder: _loginFieldBorder(AppColors.primary, width: 2),
          errorBorder: _loginFieldBorder(AppColors.error),
          focusedErrorBorder: _loginFieldBorder(AppColors.error, width: 2),
          contentPadding: const EdgeInsets.symmetric(
            horizontal: 16,
            vertical: 16,
          ),
          errorText: null,
          errorStyle: const TextStyle(height: 0),
        ),
        validator: (_) => null,
      ),
    );
  }

  Widget _buildUserError() {
    if (!_hasAttemptedValidation || _usuarioController.text.isNotEmpty) {
      return const SizedBox.shrink();
    }
    return Padding(
      padding: const EdgeInsets.only(left: 16, top: 4),
      child: Text(
        'Ingrese su usuario',
        style: TextStyle(
          color: AppColors.error,
          fontSize: 12,
          fontWeight: FontWeight.w500,
        ),
      ),
    );
  }

  Widget _buildPasswordError() {
    if (!_hasAttemptedValidation || _passwordController.text.isNotEmpty) {
      return const SizedBox.shrink();
    }
    return Padding(
      padding: const EdgeInsets.only(left: 16, top: 4),
      child: Text(
        'Ingrese su contraseña',
        style: TextStyle(
          color: AppColors.error,
          fontSize: 12,
          fontWeight: FontWeight.w500,
        ),
      ),
    );
  }

  Widget _buildPasswordField() {
    final isDark = context.isAppDark;
    return Container(
      decoration: BoxDecoration(
        borderRadius: BorderRadius.circular(12),
        boxShadow: isDark ? null : context.cardShadow(blur: 4, dy: 2),
      ),
      child: TextFormField(
        controller: _passwordController,
        focusNode: _passwordFocusNode,
        textInputAction: TextInputAction.go,
        textCapitalization: TextCapitalization.characters,
        onEditingComplete: _login,
        obscureText: _obscurePassword,
        style: TextStyle(
          fontSize: 16,
          fontWeight: FontWeight.w500,
          color: context.textThemePrimary,
        ),
        decoration: InputDecoration(
          labelText: 'Contraseña',
          floatingLabelBehavior: FloatingLabelBehavior.auto,
          labelStyle: TextStyle(
            color: context.textThemeMuted,
            fontWeight: FontWeight.w500,
            fontSize: 14,
          ),
          floatingLabelStyle: const TextStyle(
            color: AppColors.primary,
            fontWeight: FontWeight.w600,
            fontSize: 13,
          ),
          hintText: 'Ingresa tu contraseña',
          hintStyle: TextStyle(color: context.textThemeMuted.withValues(alpha: 0.7)),
          prefixIcon: Padding(
            padding: const EdgeInsets.all(12),
            child: Icon(
              Icons.lock_rounded,
              color: context.textThemeMuted,
              size: 22,
            ),
          ),
          suffixIcon: IconButton(
            icon: Icon(
              _obscurePassword
                  ? Icons.visibility_off_rounded
                  : Icons.visibility_rounded,
              color: context.textThemeMuted,
              size: 22,
            ),
            onPressed: () {
              setState(() {
                _obscurePassword = !_obscurePassword;
              });
            },
          ),
          filled: true,
          fillColor: _loginFieldFillColor,
          border: _loginFieldBorder(_loginFieldBorderColor),
          enabledBorder: _loginFieldBorder(_loginFieldBorderColor),
          focusedBorder: _loginFieldBorder(AppColors.primary, width: 2),
          errorBorder: _loginFieldBorder(AppColors.error),
          focusedErrorBorder: _loginFieldBorder(AppColors.error, width: 2),
          contentPadding: const EdgeInsets.symmetric(
            horizontal: 16,
            vertical: 16,
          ),
          errorText: null,
          errorStyle: const TextStyle(height: 0),
        ),
        validator: (_) => null,
      ),
    );
  }

  Widget _buildLoginButton() {
    return Container(
      width: double.infinity,
      height: 56,
      decoration: BoxDecoration(
        borderRadius: BorderRadius.circular(12),
        gradient: _isLoading ? null : AppColors.primaryGradient,
        boxShadow: _isLoading
            ? null
            : [
                BoxShadow(
                  color: AppColors.primary.withOpacity(0.4),
                  blurRadius: 12,
                  offset: const Offset(0, 6),
                ),
              ],
      ),
      child: ElevatedButton(
        onPressed: _isLoading ? null : _login,
        style: ElevatedButton.styleFrom(
          backgroundColor: Colors.transparent,
          shadowColor: Colors.transparent,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(12),
          ),
        ),
        child: _isLoading
            ? const SizedBox(
                height: 24,
                width: 24,
                child: CircularProgressIndicator(
                  strokeWidth: 3,
                  color: Colors.white,
                ),
              )
            : const Row(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Icon(Icons.login_rounded, size: 24, color: Colors.white),
                  SizedBox(width: 12),
                  Text(
                    'LOGIN',
                    style: TextStyle(
                      fontSize: 17,
                      fontWeight: FontWeight.w700,
                      color: Colors.white,
                    ),
                  ),
                ],
              ),
      ),
    );
  }

  Widget _buildDivider() {
    return Row(
      children: [
        Expanded(
          child: Container(
            height: 1,
            color: AppColors.primary.withOpacity(0.2),
          ),
        ),
        Padding(
          padding: const EdgeInsets.symmetric(horizontal: 16),
          child: Text(
            'o',
            style: TextStyle(
              color: context.textThemeMuted,
              fontSize: 14,
              fontWeight: FontWeight.w600,
            ),
          ),
        ),
        Expanded(
          child: Container(
            height: 1,
            color: AppColors.primary.withOpacity(0.2),
          ),
        ),
      ],
    );
  }

  Widget _buildRegisterDeviceButton() {
    return Center(
      child: TextButton.icon(
        onPressed: _isLoading
            ? null
            : () {
                Get.to(
                  () => const RegisterDeviceScreen(),
                  transition: Transition.rightToLeftWithFade,
                  duration: const Duration(milliseconds: 800),
                  curve: Curves.easeOutCubic,
                );
              },
        icon: const Icon(Icons.phone_android_rounded, color: AppColors.primary),
        label: const Text(
          'Registrar tu Dispositivo',
          style: TextStyle(
            fontSize: 15,
            fontWeight: FontWeight.w600,
            color: AppColors.primary,
          ),
        ),
        style: TextButton.styleFrom(
          padding: const EdgeInsets.symmetric(horizontal: 28, vertical: 12),
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(12),
          ),
        ),
      ),
    );
  }
}

class TopWaveClipper extends CustomClipper<Path> {
  @override
  Path getClip(Size size) {
    final path = Path();
    path.lineTo(0, 0);
    path.lineTo(0, size.height * 0.75);
    path.quadraticBezierTo(
      size.width * 0.25,
      size.height * 0.85,
      size.width * 0.5,
      size.height * 0.8,
    );
    path.quadraticBezierTo(
      size.width * 0.75,
      size.height * 0.75,
      size.width,
      size.height * 0.8,
    );
    path.lineTo(size.width, 0);
    path.close();
    return path;
  }

  @override
  bool shouldReclip(covariant CustomClipper<Path> oldClipper) => false;
}
